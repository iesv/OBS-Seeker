get_filename_component(project_dir "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
set(dist_dir "${project_dir}/dist")
if(IS_SYMLINK "${dist_dir}")
  message(FATAL_ERROR "dist must be a regular directory inside the project")
endif()
if(EXISTS "${dist_dir}")
  file(REAL_PATH "${dist_dir}" resolved_dist)
  if(NOT "${resolved_dist}" STREQUAL "${dist_dir}")
    message(FATAL_ERROR "dist must be a regular directory inside the project")
  endif()
endif()
file(REMOVE_RECURSE "${dist_dir}")
file(MAKE_DIRECTORY "${dist_dir}")
